<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DeepBrain.Studio.MainWindow"
        Width="900" Height="600"
        Title="DeepBrain Studio">
	<DockPanel Margin="12">
		<Border DockPanel.Dock="Top" Margin="0,0,0,8">
			<Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto" RowDefinitions="Auto">
				<TextBlock Name="HeartbeatText" Text="♡" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
				<TextBox Grid.Column="1" Name="HostBox" Width="160" Text="127.0.0.1"/>
				<TextBox Grid.Column="2" Name="PortBox" Width="80" Text="5555" Margin="8,0,0,0"/>
				<Button Grid.Column="3" Name="ConnectBtn" Content="Connect" Margin="8,0,0,0"/>
				<Button Grid.Column="4" Name="DisconnectBtn" Content="Disconnect" Margin="8,0,0,0"/>
				<TextBlock Grid.Column="5" Name="StatusText" Margin="12,0,0,0" VerticalAlignment="Center"/>
				<StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="8">
					<Button Name="BrainStartBtn" Content="Start"/>
					<Button Name="BrainStopBtn" Content="Stop"/>
					<Button Name="ClearBtn" Content="Clear Logs"/>
				</StackPanel>
			</Grid>
		</Border>
		<Grid ColumnDefinitions="680,24,*" RowDefinitions="Auto,*" Margin="0,4,0,0">
			<TextBlock Grid.Column="0" Text="Trace (last 50)" FontWeight="Bold"/>
			<TextBlock Grid.Column="2" Text="Life" FontWeight="Bold"/>
			<Border Grid.Row="1" Grid.Column="0" BorderThickness="1" Padding="8">
				<ItemsControl Name="TraceList">
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<TextBlock Text="{Binding}" TextWrapping="NoWrap" FontFamily="Consolas"/>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</Border>
			<GridSplitter Grid.Row="1" Grid.Column="1" Width="6"/>
			<Grid Grid.Row="1" Grid.Column="2" RowDefinitions="Auto,Auto,160,Auto,*" Margin="12,0,0,0">
				<Border Grid.Row="0" BorderThickness="1" Padding="8">
					<StackPanel Spacing="4">
						<TextBlock Name="LifeMoodText" FontWeight="Bold"/>
						<TextBlock Name="LifeHomeostasisText"/>
						<TextBlock Name="LifeInstinctsText"/>
						<TextBlock Name="LifeDecisionText"/>
						<TextBlock Name="LifeRewardText"/>
						<TextBlock Name="LifeStrategyText"/>
						<TextBlock Name="LifeDriveText"/>
						<TextBlock Name="LifeLoopText"/>
						<TextBlock Name="LifeAvgRewardText"/>
						<TextBlock Name="LifeInertiaText"/>
					</StackPanel>
				</Border>
				<TextBlock Grid.Row="1" Text="Outputs" FontWeight="Bold" Margin="0,8,0,4"/>
				<Border Grid.Row="2" BorderThickness="1" Padding="8" Height="160" VerticalAlignment="Top">
					<ScrollViewer VerticalScrollBarVisibility="Auto">
						<ItemsControl Name="OutputsList">
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<TextBlock Text="{Binding}" TextWrapping="Wrap"/>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</ScrollViewer>
				</Border>
				<TextBlock Grid.Row="3" Text="Logs" FontWeight="Bold" Margin="0,8,0,4"/>
				<Border Grid.Row="4" BorderThickness="1" Padding="8">
					<ScrollViewer>
						<ItemsControl Name="LogsList">
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<TextBlock Text="{Binding}" TextWrapping="Wrap"/>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</ScrollViewer>
				</Border>
			</Grid>
		</Grid>
	</DockPanel>
</Window>

