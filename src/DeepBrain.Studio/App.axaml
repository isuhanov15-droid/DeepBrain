<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DeepBrain.Studio.App"
             RequestedThemeVariant="Default">
             <!-- Default следует системной теме; также доступны Dark и Light. -->

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>
